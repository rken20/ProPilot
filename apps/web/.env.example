# Copy to .env.local (never commit it). Values come from your Supabase project:
# Supabase dashboard → Project Settings → API.

# Public: safe in the browser, protected by row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The app's public address, used in email and invite links (prevents forged-Host links).
APP_ORIGIN=https://pro-pilot-git-main-pro-pilot1.vercel.app

# Server-only: never prefix with NEXT_PUBLIC_. Used for lead emails, Google sync and webhooks.
SUPABASE_SERVICE_ROLE_KEY=

# Email alerts to agents. Set ONE of these:
#   Resend (needs your own domain verified at resend.com)
RESEND_API_KEY=
#   or SMTP, e.g. Gmail with an app password (smtp.gmail.com, 465)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=
# The From line, e.g. ProPilot AI <alerts@yourdomain.ph>
# EMAIL_FROM=

# Connect Google (Sheets + Calendar). OAuth client from console.cloud.google.com.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The stable address registered as the redirect URI, e.g. https://pro-pilot-git-main-pro-pilot1.vercel.app
GOOGLE_REDIRECT_ORIGIN=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Server-only: powers "Ask about this property" for buyers. From console.anthropic.com.
# Without it the app works and the chat explains the assistant isn't switched on yet.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-haiku-5-5).
# ANTHROPIC_MODEL=
# The same key also lets buyers search other property sites (Lamudi, Dot Property and others),
# together with SUPABASE_SERVICE_ROLE_KEY. Optional model override for that search:
# ANTHROPIC_SEARCH_MODEL=

# Connect Facebook Pages (import posts as listings, post listings to the Page).
# From your Meta app at developers.facebook.com: App settings → Basic. Needs TOKEN_ENCRYPTION_KEY too.
META_APP_ID=
META_APP_SECRET=
# The stable address registered in the Meta app; the redirect URI is <origin>/api/meta/callback
META_REDIRECT_ORIGIN=
# Optional: Facebook Login for Business configuration ID (replaces the scope list), Graph version, extra scopes
# META_LOGIN_CONFIG_ID=
# META_GRAPH_VERSION=v25.0
# META_EXTRA_SCOPES=business_management

# Shown on /privacy as the address for privacy requests.
PRIVACY_CONTACT_EMAIL=

# Later phases (leave empty for now)
# PAYMONGO_SECRET_KEY=
# PAYMONGO_WEBHOOK_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
